{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "wails-debug",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GOCACHE": "/tmp/dude-go-build"
        }
      },
      "command": "mise",
      "args": [
        "exec",
        "--",
        "/home/andreas/go/bin/wails",
        "build",
        "-debug",
        "-tags",
        "${input:debugFeature}"
      ],
      "detail": "Wails debug build with DWARF symbols"
    },
    {
      "label": "wails-debug-windows",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GOCACHE": "/tmp/dude-go-build"
        }
      },
      "command": "mise",
      "args": [
        "exec",
        "--",
        "/home/andreas/go/bin/wails",
        "build",
        "-debug",
        "-tags",
        "${input:debugFeature}"
      ],
      "detail": "Wails debug build with DWARF symbols (Windows)"
    },
    {
      "label": "wails-linux-build",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GOCACHE": "/tmp/dude-go-build"
        }
      },
      "command": "mise",
      "args": [
        "exec",
        "--",
        "/home/andreas/go/bin/wails",
        "build",
        "-platform",
        "linux/amd64",
        "-upx",
        "-upxflags",
        "--best",
        "-ldflags",
        "-s -w",
        "-webview2",
        "embed"
      ],
      "detail": "Full Wails build for Linux/amd64 with UPX and LDFLAGS"
    }
  ],
  "inputs": [
    {
      "id": "debugFeature",
      "type": "pickString",
      "description": "Choose the execution mode to debug",
      "options": [
        "real_execution",
        "debug_progress"
      ],
      "default": "real_execution"
    }
  ]
}
